FROM python:3.10-slim

# Sadece gerekli sistem paketlerini yükle (Chrome/Selenium olmadan)
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Backend klasöründeki dosyaları kopyala
COPY backend/requirements.railway.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# FastAPI port
EXPOSE 8000

# Startup script oluştur
RUN echo '#!/bin/sh\nuvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}' > /start.sh && \
    chmod +x /start.sh

# API'yi başlat
CMD ["/bin/sh", "/start.sh"]

