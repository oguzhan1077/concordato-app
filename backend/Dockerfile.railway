FROM python:3.10-slim

# Sadece gerekli sistem paketlerini yükle (Chrome/Selenium olmadan)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Railway için özel requirements (scraper olmadan)
# Railway build context root'ta olduğu için backend/ prefix'i gerekli
# Önce sadece requirements'ı kopyala (cache için)
COPY backend/requirements.railway.txt requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Backend klasörünü kopyala (Railway build context root'ta)
COPY backend/ .

# Entrypoint script'ini çalıştırılabilir yap
RUN chmod +x entrypoint.sh

# FastAPI port (Railway otomatik PORT set eder)
EXPOSE 8000

# Entrypoint script'ini kullan (PORT environment variable'ını düzgün handle eder)
ENTRYPOINT ["./entrypoint.sh"]

